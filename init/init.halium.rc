# init.halium.rc
# Applied when the Android system boots inside the Droidian LXC container.
# Droidian owns the display, audio, networking, and power management;
# the Android container provides only the hardware HAL layer.

on early-init
    setprop ro.boot.container 1
    setprop ro.halium.version 12

on init
    # Droidian's init (systemd) handles /data mounting
    setprop vold.decrypt trigger_default_encryption

on post-fs-data
    setprop halium.booting 1

on property:sys.boot_completed=1
    setprop halium.booting 0
    setprop halium.running 1

# ---------------------------------------------------------------------------
# Services to DISABLE inside the container
# ---------------------------------------------------------------------------

# SurfaceFlinger — Phoc/Weston owns the DRM node
on property:ro.boot.container=1
    stop surfaceflinger

# Audio — Droidian's PipeWire/PulseAudio-hybris owns the hardware
on property:ro.boot.container=1
    stop audioserver
    stop audio-hal-aidl
    stop vendor.audio-hal
    stop vendor.audio-hal-aidl

# Camera — accessed via libhybris from Droidian userspace
on property:ro.boot.container=1
    stop cameraserver
    stop vendor.camera-provider-2-4
    stop vendor.camera-provider-2-5
    stop vendor.camera-provider-2-7

# Android networking daemons — Droidian's NetworkManager owns WiFi and
# routing; ofono owns the modem data path via qcrild (see below).
# Do NOT stop qcrild here — ofono needs it to reach the modem.
on property:ro.boot.container=1
    stop netd
    stop wpa_supplicant
    stop vendor.cnss_diag

# vold — Droidian mounts partitions
on property:ro.boot.container=1
    stop vold

# Power/suspend — Droidian owns suspend policy
on property:ro.boot.container=1
    stop vendor.power-hal-aidl
    stop android.hardware.power-service.pixel-libperfmgr
    stop vendor.qti-power

# Thermal — Droidian's thermald handles this
on property:ro.boot.container=1
    stop vendor.thermal-engine
    stop vendor.thermal-hal-2-0
    stop vendor.thermalservice

# Keymaster / Gatekeeper — not needed (no Android lockscreen)
on property:ro.boot.container=1
    stop vendor.keymint-qti
    stop vendor.gatekeeper-1-0

# DRM / Widevine — unused in Droidian container context
on property:ro.boot.container=1
    stop vendor.drm-widevine
    stop android.hardware.drm-service.clearkey

# ---------------------------------------------------------------------------
# Services to KEEP running (provide HALs to Droidian via binder/socket)
# ---------------------------------------------------------------------------
#
# vendor.qcrild / vendor.qcrild2
#   KEEP: ofono connects to the modem through the RIL socket exposed by
#   qcrild. Stopping it would break calls, SMS, and mobile data.
#
# vendor.imsqmidaemon / vendor.imsdatadaemon / vendor.ims_rtp_daemon
#   KEEP: required for IMS registration and VoLTE/VoWiFi.
#
# vendor.sensors-hal-multihal   — sensor HAL (geoclue, compass, etc.)
# vendor.bluetooth-service-qti  — Bluetooth HAL (BlueZ via hybris)
# vendor.gnss-service            — GNSS HAL (geoclue-hybris)
# vendor.vibrator-service        — haptics
# vendor.light-default-service   — LED / display backlight
# vendor.nfc_hal_service         — NFC
# vendor.health-default           — battery info (upower)
